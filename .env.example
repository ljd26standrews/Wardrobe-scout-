# Copy to .env (repo root) and adjust. Everything is optional.

# ---- Backend (FastAPI) ----
# Database: SQLite by default (backend/data/wardrobe_scout.db). PostgreSQL example:
# WS_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/wardrobe_scout
# WS_DATA_DIR=/absolute/path/for/images-and-db

# Politeness for catalogue scans (each host separately; different hosts run in parallel)
WS_REQUEST_DELAY_SECONDS=2.0
# WS_IMAGE_REQUEST_DELAY_SECONDS=2.0   # image CDN hosts; unset = same as above
WS_MAX_PAGES_PER_SCAN=250
WS_RESPECT_ROBOTS_TXT=true
WS_DOWNLOAD_IMAGES=true

# Photo analysis per product (see README "How a scan runs" and backend/bench/RESULTS.md)
# WS_ANALYSIS_IMAGES=1        # useful garment views per product; 2 = more thorough duplicate matching
# WS_MAX_EXAMINE_IMAGES=6     # download budget per product when looking for those views
# WS_DEEP_IMAGES=8            # photos for duplicate candidates and products you love/save
# WS_REFRESH_DAYS=14          # re-read unchanged product pages after this long (spread over scans)

# Background refresh scheduler (checks hourly which sellers are due)
WS_ENABLE_SCHEDULER=true

# Image embeddings: auto | clip | lite  (auto uses CLIP if installed via requirements-ml.txt)
WS_EMBEDDING_BACKEND=auto

# Render JS-only pages (e.g. Weidian items) in headless Chromium. Requires: playwright install chromium
WS_ENABLE_PLAYWRIGHT=false

# Optional AI features (translation, photo observations, research summaries).
# Also switch them on in Settings → AI. Spending is capped there (default $5/month).
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Frontend (Next.js) ----
BACKEND_URL=http://127.0.0.1:8000
# Used by the bookmarklet in your browser
NEXT_PUBLIC_BACKEND_PUBLIC_URL=http://localhost:8000
